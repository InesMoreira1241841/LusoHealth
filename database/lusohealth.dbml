// ------------------------- LUSOHEALTH -------------------------


// ENUMERAÇÕES (domínios de valores controlados)

Enum tipo_entrada_equipamento {
  "Compra"
  "Doação"
  "Aluguer"
  "Empréstimo"
}

Enum estado_equipamento {
  "Ativo"
  "Em manutenção"
  "Em calibração"
  "Em quarentena"
  "Abatido"
}

Enum criticidade_equipamento {
  "Baixa"
  "Média"
  "Alta"
  "Suporte de vida"
}

Enum tipo_relacao_fornecedor {
  "Fabricante"
  "Distribuidor"
  "Assistência técnica"
}

Enum tipo_fornecedor {
  "Fabricante"
  "Distribuidor"
  "Assistência Técnica"
  "Consumíveis"
}

Enum tipo_garantia {
  "Garantia de Fábrica"
  "Contrato de Manutenção"
  "Outro"
}


// TABELAS

Table categorias {
  id int [pk, increment]
  nome varchar(100) [unique, not null, note: 'Ex: Monitorização, Suporte de vida']

  Note: 'Categorias/famílias funcionais de equipamentos médicos (ex: Diagnóstico, Esterilização, Laboratório).'
}

Table localizacoes {
  id int [pk, increment]
  codigo varchar(20) [unique, not null, note: 'Ex: SRV-UCI']
  nome varchar(100) [not null]
  edificio varchar(50) [not null]
  piso tinyint [not null, default: 0]
  responsavel varchar(100)
  observacoes text
  arquivado tinyint [not null, default: 0]
  criado_em datetime [not null, default: `now()`]
  atualizado_em timestamp

  Note: 'Localizações físicas hospitalares (serviço, edifício, piso) onde os equipamentos podem estar instalados.'
}

Table fornecedores {
  id int [pk, increment]
  nome varchar(150) [not null]
  nif varchar(20) [unique, not null]
  tipo tipo_fornecedor [not null]
  telefone varchar(30)
  email varchar(100)
  morada varchar(200)
  website varchar(150)
  tecnico_nome varchar(100)
  tecnico_telefone varchar(30)
  observacoes text
  arquivado tinyint [not null, default: 0]
  criado_em datetime [not null, default: `now()`]
  atualizado_em datetime

  Note: 'Entidades externas associadas aos equipamentos: fabricantes, distribuidores, assistência técnica ou fornecedores de consumíveis.'
}

Table equipamentos {
  id int [pk, increment]
  codigo_inventario varchar(30) [unique, not null, note: 'Ex: INV-0091']
  designacao varchar(150) [not null]
  categoria_id int [ref: > categorias.id, note: 'ON DELETE SET NULL']
  marca varchar(100) [not null]
  modelo varchar(100) [not null]
  num_serie varchar(100) [unique, not null]
  ano_fabrico year
  data_aquisicao date
  custo_aquisicao "decimal(10,2)" [note: 'CHECK custo_aquisicao >= 0']
  tipo_entrada tipo_entrada_equipamento [not null]
  estado estado_equipamento [not null]
  criticidade criticidade_equipamento [not null]
  localizacao_id int [ref: > localizacoes.id, note: 'ON DELETE SET NULL']
  observacoes text
  criado_em datetime [not null, default: `now()`]
  atualizado_em datetime

  Note: 'Entidade central do sistema: cada dispositivo médico registado no inventário hospitalar.'
}

Table equipamento_fornecedor {
  equipamento_id int [ref: > equipamentos.id, note: 'ON DELETE CASCADE']
  fornecedor_id int [ref: > fornecedores.id, note: 'ON DELETE CASCADE']
  tipo_relacao tipo_relacao_fornecedor [not null]

  indexes {
    (equipamento_id, fornecedor_id) [pk]
  }

  Note: 'Tabela de associação N:M entre equipamentos e fornecedores, qualificada pelo papel desempenhado (Fabricante, Distribuidor, Assistência técnica).'
}

Table documentos {
  id int [pk, increment]
  equipamento_id int [not null, ref: > equipamentos.id, note: 'ON DELETE CASCADE']
  fornecedor_id int [ref: > fornecedores.id, note: 'ON DELETE SET NULL']
  tipo varchar(50) [not null, note: 'Manual do Utilizador / Manual de Serviço / Certificado de Calibração / etc.']
  nome_documento varchar(255) [not null]
  data_documento date
  data_validade date
  notas text
  ficheiro_path varchar(255) [note: 'Caminho do PDF local (Forma 1)']
  url_externo varchar(2000) [note: 'Link para Cloud/OneDrive (Forma 2)']
  arquivado tinyint [not null, default: 0]
  criado_em datetime [not null, default: `now()`]

  Note: 'Documentação técnica e administrativa associada a um equipamento e, opcionalmente, a um fornecedor.'
}

Table garantias {
  id int [pk, increment]
  num_contrato varchar(50) [unique, not null, note: 'Ex: CTR-DRG-0001']
  equipamento_id int [not null, ref: > equipamentos.id, note: 'ON DELETE CASCADE']
  fornecedor_id int [ref: > fornecedores.id, note: 'ON DELETE SET NULL, opcional']
  tipo tipo_garantia [not null]
  data_inicio date [not null]
  data_fim date [not null, note: 'CHECK data_fim > data_inicio']
  periodicidade varchar(50)
  ficheiro_path varchar(255) [note: 'Caminho do PDF local (Forma 1)']
  url_externo varchar(2000) [note: 'Link para Cloud/OneDrive (Forma 2)']
  observacoes text
  arquivado tinyint [not null, default: 0]
  criado_em datetime [not null, default: `now()`]
  atualizado_em datetime

  Note: 'Garantias de fábrica e contratos de manutenção associados a um equipamento.'
}

Table conteudos_publicos {
  id int [pk, increment]
  chave varchar(50) [unique, not null, note: 'Ex: nome_hospital, telefone, email, texto_home']
  valor text [not null]
  atualizado_em datetime

  Note: 'Conteúdos editáveis do website público (Front Office), geridos via Back Office sem necessidade de editar HTML diretamente.'
}

Table utilizadores {
  id int [pk, increment]
  username varchar(50) [unique, not null]
  password varchar(255) [not null, note: 'Hash gerado com password_hash() (bcrypt)']

  Note: 'Contas de acesso à área privada (Back Office) da aplicação.'
}
